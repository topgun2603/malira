<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon, Android 8 and up.

  The launcher masks this to whatever shape the device uses — circle, squircle,
  teardrop — and may parallax the two layers apart, so the mark is drawn inside
  the guaranteed-visible middle 66 of 108 units. The PNGs are generated by
  tool/make_logo.py from the same palette tokens as the app itself.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
