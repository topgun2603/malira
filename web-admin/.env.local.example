# Firebase Web app config
# Project settings > General > Your apps > Web app
#
# These are NEXT_PUBLIC_ and ship in the browser bundle by design. The web API
# key is an identifier, not a secret — access is controlled by firestore.rules
# and storage.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional — not used by the admin panel.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Payments (Razorpay) --------------------------------------------------
# Server-only. NEVER prefix the secret with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set the same value in the Razorpay dashboard webhook for payment.captured
RAZORPAY_WEBHOOK_SECRET=

# --- Firebase Admin (server) ----------------------------------------------
# Service account JSON, raw or base64. Needed to verify ID tokens and to write
# subscription entitlements, which the browser must never be able to forge.
FIREBASE_SERVICE_ACCOUNT=
