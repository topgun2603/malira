rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function profileRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function canWriteArticles() {
      return signedIn() && profileRole() in ['super_admin', 'editor', 'contributor'];
    }

    match /articles/{articleKey}/{fileName} {
      // Article images are public: the mobile app renders them straight from
      // the download URL, including for readers who are not signed in yet.
      allow read: if true;

      // The client already compresses to JPEG under ~350KB; 2MB is a generous
      // ceiling that still stops someone uploading a video by mistake.
      allow write: if canWriteArticles()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if canWriteArticles();
    }

    // Matrimony photographs. Not world-readable, unlike article images.
    //
    // Caveat worth stating plainly: getDownloadURL returns a tokenised URL that
    // bypasses these rules for anyone holding it. The protection that actually
    // matters is that restricted photo URLs live in the private Firestore
    // subcollection and are never sent to a browser that has not earned them.
    match /matrimony/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Directory photographs.
    //
    // World-readable, unlike everything else here, because the directory itself
    // is: a family looking for a hall has not signed in, and a photograph they
    // cannot load is a listing the vendor paid for and nobody can see. Written
    // only into the owner's own folder.
    match /vendors/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Payment proof: a screenshot of somebody's banking app.
    //
    // Write-only from the payer's side, and never world-readable. A payment
    // screenshot carries a name, a balance and an account fragment, so it is
    // not the sort of image that should be guessable by URL the way an article
    // photograph is. Only the desk reading it back has any business with it,
    // and that read is gated by the same sign-in the admin panel requires.
    match /payments/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // Never deleted by the payer: the proof is the audit trail for money that
      // has already been granted against it.
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
